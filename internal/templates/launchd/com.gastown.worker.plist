<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gastown.worker</string>

    <!-- ShellCommand sources <state-dir>/worker.env (0600) before exec so
         secrets — the unix-mode pre-shared token — reach the worker through the
         environment instead of argv, which is world-readable via ps. launchd
         inherits a stripped environment, so shell rc files do not propagate;
         `set -a` matches systemd's EnvironmentFile semantics.

         Every interpolation is XML-escaped here, and the shell line is
         assembled with shell quoting in Go: this file is BOTH an XML document
         and a /bin/sh -c argument, so a path containing & or a quote would
         otherwise either make launchd reject the job or break out of the
         command line. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>{{xml .ShellCommand}}</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{xml .StateDir}}</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- A worker that exits has abandoned its sessions; the orchestrator sees
         them as orphaned and re-provisions. Always come back. -->
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{xml .LogPath}}</string>

    <key>StandardErrorPath</key>
    <string>{{xml .LogPath}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{xml .Path}}</string>
    </dict>

    <!-- The agent is interactive work, not a batch job: Background would have
         it throttled and its I/O deprioritized. -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
